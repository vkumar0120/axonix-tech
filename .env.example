VITE_SITE_URL=https://www.axonixtechnologies.com
VITE_CONTACT_EMAIL=support@axonixtechnologies.com
VITE_PHONE=+917448554709

PORT=4000
NODE_ENV=production

# Email delivery for the contact form
RESEND_API_KEY=your_resend_api_key_here
FROM_ADDRESS=hello@yourdomain.com
TO_ADDRESS=support@axonixtechnologies.com

# Live AI assistant: choose either OpenAI or Azure OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01
